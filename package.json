{
  "name": "time-escola-negocios",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:critical && node --test tests/rendered-html.test.mjs tests/event-checkin.test.mjs tests/course-experience.test.mjs",
    "test:viewports": "playwright test tests/e2e/viewports.spec.ts",
    "test:critical": "node --experimental-strip-types --test tests/access-policy.test.ts tests/access-routes.test.mjs tests/critical-flows.test.mjs tests/course-block4.test.mjs tests/block5-events-community.test.ts tests/block6-billing.test.mjs tests/block7-member-home.test.ts tests/contrast-accessibility.test.mjs tests/staging-readiness.test.mjs tests/landing-course-carousel.test.mjs",
    "mobile:check": "node scripts/mobile-check.mjs",
    "mobile:associations": "node scripts/mobile-associations.mjs",
    "mobile:sync": "npm run mobile:check && cap sync",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:build:android": "npm run mobile:sync && cd android && ./gradlew bundleRelease",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@stripe/react-stripe-js": "6.8.0",
    "@stripe/stripe-js": "9.12.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "TIME Escola de Negócios"
}
